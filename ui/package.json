{
  "name": "ocupilot-ui",
  "version": "0.0.0",
  "private": true,
  "description": "OcuPilot Angular shell (Story 1.1 workspace/version guard; Story 1.2 tokens/type/strings + client lint).",
  "scripts": {
    "prebuild": "node tools/version-guard.mjs && node tools/client-lint.mjs",
    "pretest": "node tools/version-guard.mjs",
    "prestart": "node tools/version-guard.mjs && node tools/client-lint.mjs",
    "build": "ng build",
    "start": "ng serve",
    "test": "node --test tools/",
    "test:tools": "node --test tools/"
  },
  "engines": {
    "node": "^22.22.3 || ^24.15.0 || ^26.0.0"
  },
  "dependencies": {
    "@angular/animations": "22.1.5",
    "@angular/cdk": "22.1.5",
    "@angular/common": "22.1.5",
    "@angular/compiler": "22.1.5",
    "@angular/core": "22.1.5",
    "@angular/forms": "22.1.5",
    "@angular/material": "22.1.5",
    "@angular/platform-browser": "22.1.5",
    "@angular/router": "22.1.5",
    "rxjs": "7.8.2",
    "tslib": "2.8.1"
  },
  "devDependencies": {
    "@angular/build": "22.1.5",
    "@angular/cli": "22.1.5",
    "@angular/compiler-cli": "22.1.5",
    "@types/jasmine": "6.0.0",
    "@types/node": "24.13.3",
    "typescript": "6.0.3"
  }
}
