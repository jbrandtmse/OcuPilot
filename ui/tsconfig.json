{
  "compileOnSave": false,
  "compilerOptions": {
    "outDir": "./dist/out-tsc",
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "dom"],
    "skipLibCheck": true,
    "esModuleInterop": true,
    "experimentalDecorators": true,
    "importHelpers": true,
    "sourceMap": true,
    "declaration": false,
    "strict": true,
    "noImplicitOverride": true,
    "noPropertyAccessFromIndexSignature": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "isolatedModules": true,
    // The client mirror is imported with its `.ts` extension so `node --test`'s type
    // stripping resolves it: Node requires an extension on a relative specifier, and
    // `moduleResolution: "bundler"` accepts the real one only with this flag. TypeScript
    // requires `noEmit` alongside it, which costs nothing here -- `@angular/build` compiles
    // through esbuild and never uses `tsc`'s own emit.
    "allowImportingTsExtensions": true,
    "noEmit": true
  },
  "angularCompilerOptions": {
    "strictTemplates": true,
    "strictInjectionParameters": true,
    "strictInputAccessModifiers": true
  }
}
