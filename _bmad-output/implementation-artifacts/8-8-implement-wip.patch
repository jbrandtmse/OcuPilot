+        <legend class="ocu-field-label">{{ STRINGS.deviceFieldPrompt }}</legend>
+        @for (choice of promptChoices; track choice.value) {
+          <label class="ocu-field-checkbox">
+            <input
+              type="radio"
+              name="ocu-device-Prompt"
+              [id]="promptField.id + '-' + (choice.value || 'show')"
