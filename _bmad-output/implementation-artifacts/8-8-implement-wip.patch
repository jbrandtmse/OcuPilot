+              [checked]="choice.value === value('Prompt')"
+              [disabled]="locked"
+              (change)="onPrompt(choice.value)"
+            />
+            <span>{{ choice.label }}</span>
+          </label>
+        }
+        @if (promptField.invalid) {
+          <p class="ocu-form-error" [id]="promptField.id + '-reason'">{{ promptField.reason }}</p>
+        }
+      </fieldset>
+    </div>
+
+    <div class="ocu-form-bar">
