+
+    Set tBefore = ##class(OcuPilot.Test.AuditingUpdate).AuditEnabled()
+    Do $$$AssertEquals(tBefore, 1, "this instance is audited before the refusal")
+    Set tSC = ..ActOn($ClassMethod(..#AUDITINGSCREEN, "ToolIdentifier"), "disable", ##class(OcuPilot.Kernel.EntityRef).#RULESINGLETONID, ..#PRINCIPALUSER, ..#PRINCIPALPASSWORD, .tStatus, .tBody, .tHeaders)
