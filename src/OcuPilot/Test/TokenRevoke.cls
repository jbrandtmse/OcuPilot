/// <p>Pins the Users list's OAuth 2.0 token revoke (AD-8, AD-10, AD-15, AD-51, AD-52, AD-53):
/// what <class>OcuPilot.Screen.Tool.UserTokenRevoke</class> declares, how
/// <class>OcuPilot.Port.TokenPort</class> resolves an account, the screen route over the matrix of
/// accounts with exact token counts, the agent's mint and marked confirm, the prohibited set
/// permitting the caller and <code>_SYSTEM</code>, and a principal without
/// <code>%Admin_OAuth2_Registration:USE</code> refused by name on both callers.</p>
/// <p><b>What it needs from the environment:</b> OcuPilot installed and serving, auditing on, an
/// account holding <code>%All</code>, and <parameter>ARMINGVARIABLE</parameter> reading
/// <code>1</code> -- <method>OnBeforeAllTests</method> refuses anywhere it does not, because
/// <class>OcuPilot.Test.TokenProbe</class> creates users, a role and token rows for every
/// method.</p>
Class OcuPilot.Test.TokenRevoke Extends %UnitTest.TestCase
{

/// <p>The environment variable that arms this class, set by <file>scripts/ci-throwaway.sh</file>
/// alone.</p>
Parameter ARMINGVARIABLE = "OCUPILOT_ALLOW_PRINCIPALS";

Parameter PROBE = "OcuPilot.Test.TokenProbe";

Parameter TOOL = "permissions.users.revoketokens";

Parameter TOOLCLASS = "OcuPilot.Screen.Tool.UserTokenRevoke";

Parameter PORT = "OcuPilot.Port.TokenPort";

Parameter SCREEN = "OcuPilot.Screen.Descriptor.UserList";

Parameter ENDPOINT = "Security.OAuth2.Server";

/// <p>The pair the tool declares beyond the list's own.</p>
Parameter REGISTRATIONPAIR = "%Admin_OAuth2_Registration:USE";

/// <p>The route every row action is sent to, under the test helper's base path.</p>
Parameter ACTIONPATH = "/screens/permissions.users/action";

/// <p>An account name no probe creates.</p>
Parameter ABSENT = "OcuPilotTestRevokeNobody";

/// <p>A name the vendor's <code>names</code> parameter reads as a pattern.</p>
Parameter WILDCARD = "OcuPilot*";

/// <p>The probe principal's password, generated by <class>OcuPilot.Test.TokenProbe</class> for
/// each method.</p>
Property PreparedPassword As %String;

Method %OnNew(initvalue As %String = "") As %Status
{
    Set tSC = ##super(initvalue)
    If $$$ISERR(tSC) Quit tSC
    Set ..PreparedPassword = ""
    Quit $$$OK
}

Method OnBeforeAllTests() As %Status
{
    If $System.Util.GetEnviron(..#ARMINGVARIABLE) '= 1 {
        Quit $$$ERROR($$$GeneralError, "OcuPilot.Test.TokenRevoke creates and deletes users, a role and OAuth 2.0 token rows on this instance and runs on a throwaway container only. " _ ..#ARMINGVARIABLE _ " does not read 1 here, so nothing was created. Bring one up with scripts/ci-throwaway.sh, which sets it.")
    }
    Quit $$$OK
}

Method OnBeforeOneTest() As %Status
{
    Do ##class(OcuPilot.Test.ProposalFixture).Clear()
    Do ##class(OcuPilot.Kernel.Proposal.Caller).Clear()
    Set tSC = $ClassMethod(..#PROBE, "Create", .tPassword)
    Set ..PreparedPassword = $Get(tPassword)
    Quit tSC
}

Method OnAfterOneTest() As %Status
{
    Do ##class(OcuPilot.Kernel.Proposal.Caller).Clear()
    Do ##class(OcuPilot.Test.ProposalFixture).RemoveSeeded(.tRemaining)
    Set tSC = $ClassMethod(..#PROBE, "Remove")
    Do $$$AssertStatusOK(tSC, "every probe object is removed by exact name: " _ $System.Status.GetErrorText(tSC))
    Do $$$AssertEquals(..Counts(), "0/0/0", "and no probe token row is left")
    Quit $$$OK
}

/// <p>The three probe spellings' token counts, <code>holder/recased/other</code>.</p>
Method Counts() As %String
{
    Quit $ClassMethod(..#PROBE, "Count", $Parameter(..#PROBE, "HOLDER")) _ "/" _ $ClassMethod(..#PROBE, "Count", $Parameter(..#PROBE, "RECASED")) _ "/" _ $ClassMethod(..#PROBE, "Count", $Parameter(..#PROBE, "OTHER"))
}

/// <p>One row action over the route as <var>pUser</var>, or as the test helper's own account when
/// <var>pUser</var> is empty, or carrying the access token <var>pBearer</var> when one is given,
/// answering the HTTP status and the parsed envelope.</p>
Method Act(pId As %String, Output pStatus As %Integer, Output pBody, pUser As %String = "", pPassword As %String = "", pBearer As %String = "") As %Status
{
    Set pBody = ""
    Set tRequest = {"action": "revoke-tokens"}
    Do tRequest.%Set("id", pId, "string")
    Kill tExtra
    If pBearer '= "" {
        Set tExtra("Authorization") = "Bearer " _ pBearer
    } ElseIf pUser = "" {
        Set pUser = ##class(OcuPilot.Test.Http).GetTestUsername()
        Set pPassword = ##class(OcuPilot.Test.Http).GetTestPassword()
    }
    Set tSC = ##class(OcuPilot.Test.Http).AbsoluteRequest("POST", $Parameter("OcuPilot.Test.Http", "BASEPATH") _ ..#ACTIONPATH, pUser, pPassword, .pStatus, .tRaw, .tHeaders, tRequest.%ToJSON(), "application/json", .tExtra)
    Try { Set pBody = ##class(%DynamicObject).%FromJSON(tRaw) } Catch { Set pBody = $Get(tRaw) }
    Quit tSC
}

/// <p>The code a route envelope <var>pBody</var> carries, or <code>""</code>.</p>
Method Code(pBody) As %String
{
    If '$IsObject(pBody) Quit ""
    Quit pBody.%Get("code")
}

/// <p>AD-51, AD-52, AD-8: an action-style, destructive write over <code>Security.OAuth2.Server</code>
/// <code>REVOKE</code>, read through the token port's <code>HOLDER</code>, fingerprinted over
/// <code>Name</code>, carrying the list's <code>revoke-tokens</code> row action, and requiring the
/// list's two pairs and <parameter>REGISTRATIONPAIR</parameter>.</p>
Method TestTheToolIsADestructiveActionWriteOverTheListsPairsAndTheRegistrationPair()
{
    Set tSC = ##class(OcuPilot.Screen.Tool.Registry).Resolve(..#TOOL, .tTool)
    Do $$$AssertStatusOK(tSC, "the registry resolves the tool by name")
    Do $$$AssertTrue($IsObject($Get(tTool)), "and finds it")
    If '$IsObject($Get(tTool)) Quit
    Do $$$AssertEquals(tTool.%Get("kind") _ " " _ tTool.%Get("class"), "write " _ ..#TOOLCLASS, "a write tool answered by its own class")
    Set tClass = ..#TOOLCLASS
    Do $$$AssertEquals($ClassMethod(tClass, "PortClass"), ..#PORT, "behind the token port")
    Do $$$AssertEquals($ClassMethod(tClass, "Endpoint") _ " " _ $ClassMethod(tClass, "IdArgument") _ " " _ $ClassMethod(tClass, "IdParam"), ..#ENDPOINT _ " Name user", "over the authorization server's endpoint, named by Name and sent as user")
    Do $$$AssertEquals($ClassMethod(tClass, "ReadType") _ " " _ $ClassMethod(tClass, "WriteType") _ " " _ $ClassMethod(tClass, "SendsBody") _ " " _ $ClassMethod(tClass, "ChangeAction") _ " " _ $ClassMethod(tClass, "Destructive"), "HOLDER REVOKE 0 updated 1", "a bodyless, destructive revoke publishing updated")
    Do $$$AssertEquals($ClassMethod(tClass, "SettableFields"), "", "admitting no field")
    Do $$$AssertEquals($ListToString($ClassMethod(tClass, "FingerprintSubject")) _ " " _ $ClassMethod(tClass, "PreconditionField") _ " " _ $ClassMethod(tClass, "StateField"), "Name Name OAuthTokens", "fingerprinted over Name, its precondition, with the OAuthTokens state row")
    Do $$$AssertEquals(##class(OcuPilot.Screen.Registry).FingerprintSubjectProblem(tClass), "", "which the registration guard holds adequate")
    Do $$$AssertEquals($ListToString($ClassMethod(tClass, "ScreenActionIds")), "revoke-tokens", "carrying the list's revoke-tokens row action")
    Do $$$AssertTrue(##class(OcuPilot.Port.AdminPort).IsMutating(..#ENDPOINT, "REVOKE") && ##class(OcuPilot.Port.AdminPort).IsBodyless(..#ENDPOINT, "REVOKE"), "the port admits the revoke as a bodyless write")
    Set tExpected = $ClassMethod(..#SCREEN, "PrivilegePairs") _ $ListBuild($ListFromString(..#REGISTRATIONPAIR, ":"))
    Do $$$AssertEquals(..Pairs($ClassMethod(tClass, "PrivilegePairs", "", .tResolved)), ..Pairs(tExpected), "requiring the list's own pairs and the registration pair")
    Do $$$AssertEquals(..Pairs(##class(OcuPilot.Screen.Tool.Registry).RequiredPairs(tTool, .tResolved)), ..Pairs(tExpected), "and so does the registry the agent's dispatch reads")
    Set tSchema = $ClassMethod(tClass, "InputSchema")
    Set tKeys = ""
    Set tIterator = tSchema.%Get("properties").%GetIterator()
    While tIterator.%GetNext(.tKey, .tValue) { Set tKeys = tKeys _ $ListBuild(tKey) }
    Do $$$AssertEquals($ListToString(tKeys), "Name,rationale,expectedImpact,reverse", "the schema is the account's name and the agent's own words")
}

/// <p>One agent call to the tool for the holder through the shipped dispatch chain, driven by
/// <class>OcuPilot.Test.ToolDispatchProbe</class> over the shipped registry with
/// <parameter>REGISTRATIONPAIR</parameter> not held, as
/// <code>&lt;isError&gt;|&lt;code&gt;|&lt;failedPair&gt;</code>. The probe turn's ledger rows are
/// removed.</p>
Method DispatchRefusal() As %String
{
    Set tProbe = "OcuPilot.Test.ToolDispatchProbe"
    Set tSC = ##class(OcuPilot.Test.ProposalFixture).SeedTurn($Username, "completed", .tTurnKey)
    If $$$ISERR(tSC) Quit "seedfailed"
    Do $ClassMethod(tProbe, "Reset")
    Do $ClassMethod(tProbe, "SetRegistryClass", "OcuPilot.Screen.Tool.Registry")
    Do $ClassMethod(tProbe, "DenyPair", $Piece(..#REGISTRATIONPAIR, ":", 1), $Piece(..#REGISTRATIONPAIR, ":", 2))
    Set tUse = {"type": "tool_use", "id": "toolu_revoke"}
    Do tUse.%Set("name", ##class(OcuPilot.Screen.Tool.Registry).WireName(..#TOOL), "string")
    Set tInput = {"rationale": "probe", "expectedImpact": "probe", "reverse": "probe"}
    Do tInput.%Set("Name", $Parameter(..#PROBE, "HOLDER"), "string")
    Do tUse.%Set("input", tInput)
    Set tSC = $ClassMethod(tProbe, "Answer", tTurnKey, $Username, "", [(tUse)], "OcuPilot.Kernel.Agent.Limits", .tResults, .tNames, 0, 0, .tDetails)
    Do $ClassMethod(tProbe, "Reset")
    Do ##class(OcuPilot.Kernel.State.Ledger).GuardedDeleteForTurn(tTurnKey)
    If $$$ISERR(tSC) Quit "dispatchfailed"
    If '$IsObject($Get(tResults)) || (tResults.%Size() '= 1) Quit "noresult"
    Set tResult = tResults.%Get(0)
    Set tContent = ##class(%DynamicObject).%FromJSON(tResult.%Get("content"))
    Set tPair = ""
    If tContent.%GetTypeOf("detail") = "object" Set tPair = tContent.%Get("detail").%Get("failedPair")
    Quit $Select(tResult.%Get("is_error"): 1, 1: 0) _ "|" _ tContent.%Get("code") _ "|" _ tPair
}

/// <p>A pair list as <code>resource:permission</code> entries joined with commas.</p>
Method Pairs(pPairs As %List) As %String
{
    Set tOut = ""
    For tI = 1:1:$ListLength(pPairs) {
        Set tOut = tOut _ $Select(tOut = "": "", 1: ",") _ $ListToString($List(pPairs, tI), ":")
    }
    Quit tOut
}

/// <p>The token port answers <code>HOLDER</code> with the account's own <code>LIST</code> row for an
/// id in any case, carrying the stored <code>Name</code>, and 404 on the <code>not_found</code> slug
/// for an account no row names and for a wildcard; reading revokes nothing.</p>
/// <p>Mutation (Rule 19): compare <code>Name</code> exactly in
/// <method>OcuPilot.Port.TokenPort.Holder</method> -> the re-cased read goes red.</p>
Method TestThePortResolvesTheStoredNameAndRefusesWhatNoAccountIs()
{
    Kill tQuery
    Set tQuery("user") = $ZConvert($Parameter(..#PROBE, "HOLDER"), "U")
    Set tSC = $ClassMethod(..#PORT, "Invoke", ..#ENDPOINT, "HOLDER", .tQuery, "", .tRow, .tHttp, .tFault)
    Do $$$AssertStatusOK(tSC, "an upper-cased id reads: " _ $System.Status.GetErrorText(tSC))
    Do $$$AssertEquals($Select($IsObject($Get(tRow)): tRow.%Get("Name"), 1: ""), $Parameter(..#PROBE, "HOLDER"), "as the account's stored name")
    Do $$$AssertEquals(tHttp, 200, "at 200")
    For tId = ..#ABSENT, ..#WILDCARD {
        Kill tQuery
        Set tQuery("user") = tId
        Set tSC = $ClassMethod(..#PORT, "Invoke", ..#ENDPOINT, "HOLDER", .tQuery, "", .tRow, .tHttp, .tFault)
        Do $$$AssertStatusNotOK(tSC, tId _ ": no account is read")
        Do $$$AssertEquals(tHttp _ " " _ $Select($IsObject($Get(tFault)): tFault.%Get("error") _ " " _ tFault.%Get("code"), 1: ""), "404 not_found PORT.NOTFOUND", tId _ ": at 404 on the not_found slug")
    }
    Do $$$AssertEquals(..Counts(), "2/1/1", "and no token was revoked by reading")
}

/// <p>AC1 on the screen's caller: <code>revoke-tokens</code> for the holder, named in another case,
/// answers 200 <code>updated</code> and deletes its two tokens, while the token under the
/// lower-cased spelling and the other account's survive; a second revoke of an account holding
/// none answers 200; an absent account and a wildcard answer 404 with nothing revoked; and the
/// caller's own account is permitted, after which its session still answers.</p>
/// <p>Mutations (Rule 19): send <code>pQuery("user")</code> as given in
/// <method>OcuPilot.Port.TokenPort.Invoke</method> -> the re-cased revoke deletes nothing and this
/// goes red; set <parameter>OcuPilot.Screen.Tool.UserTokenRevoke.WRITETYPE</parameter> to
/// <code>DELETE</code> -> the revoke answers 501 and this goes red.</p>
Method TestTheScreenRouteRevokesExactlyTheAccountsTokens()
{
    Set tHolder = $Parameter(..#PROBE, "HOLDER")
    Set tSince = ##class(OcuPilot.Test.AuditEvent).Now()
    Do $$$AssertEquals(..Counts(), "2/1/1", "the probe holds two tokens, one under the lower-cased spelling and one for the other account")
    Do ..Act($ZConvert(tHolder, "U"), .tStatus, .tBody)
    Do $$$AssertEquals(tStatus, 200, "the revoke answers 200: " _ $Select($IsObject(tBody): tBody.%ToJSON(), 1: $Get(tBody)))
    Set tTarget = $Select($IsObject(tBody) && (tBody.%GetTypeOf("target") = "object"): tBody.%Get("target"), 1: {})
    Do $$$AssertEquals($Select($IsObject(tBody): tBody.%Get("action"), 1: ""), "updated", "publishing the updated action")
    Do $$$AssertEquals($ZConvert(tTarget.%Get("id"), "L") _ " " _ tTarget.%Get("type"), $ZConvert(tHolder, "L") _ " user", "on the account")
    Do $$$AssertEquals(..Counts(), "0/1/1", "its two tokens are gone; the lower-cased spelling's and the other account's remain")

    Do ..Act(tHolder, .tStatus, .tBody)
    Do $$$AssertEquals(tStatus, 200, "an account holding no token answers 200")
    Do $$$AssertEquals(..Counts(), "0/1/1", "and nothing else is deleted")

    For tId = ..#ABSENT, ..#WILDCARD {
        Do ..Act(tId, .tStatus, .tBody)
        Do $$$AssertEquals(tStatus _ " " _ ..Code(tBody), "404 PORT.NOTFOUND", tId _ ": no account, so 404")
    }
    Do $$$AssertEquals(..Counts(), "0/1/1", "and nothing is revoked for either")

    ; The caller signs in first, so the access token OcuPilot issued is held across its own revoke.
    Set tSelf = ##class(OcuPilot.Test.Http).GetTestUsername()
    Set tLogin = {}
    Do tLogin.%Set("user", tSelf, "string")
    Do tLogin.%Set("password", ##class(OcuPilot.Test.Http).GetTestPassword(), "string")
    Kill tExtra
    Set tSC = ##class(OcuPilot.Test.Http).AbsoluteRequest("POST", $Parameter("OcuPilot.Test.Http", "BASEPATH") _ "/login", "", "", .tLoginStatus, .tLoginRaw, .tHeaders, tLogin.%ToJSON(), "application/json", .tExtra)
    Set tBearer = ""
    Try { Set tBearer = ##class(%DynamicObject).%FromJSON(tLoginRaw).%Get("access_token") } Catch { Set tBearer = "" }
    Do $$$AssertTrue((tLoginStatus = 200) && (tBearer '= ""), "the caller signs in and holds an access token")
    Do ..Act(tSelf, .tStatus, .tBody, , , tBearer)
    Do $$$AssertEquals(tStatus, 200, "revoking the caller's own tokens with that token is permitted")
    Kill tExtra
    Set tExtra("Authorization") = "Bearer " _ tBearer
    Set tSC = ##class(OcuPilot.Test.Http).AbsoluteRequest("GET", $Parameter("OcuPilot.Test.Http", "BASEPATH") _ "/navigation", "", "", .tNavStatus, .tNavRaw, .tHeaders, "", "", .tExtra)
    Do $$$AssertEquals(tNavStatus, 200, "and the same access token still answers, because OcuPilot's session is not an authorization-server token")
    Do $$$AssertEquals(##class(OcuPilot.Test.AuditMarker).MarkerRows(tSince, ..#TOOL, .tData), 0, "the screen path emits no agent-write marker (AD-53)")
}

/// <p>AC2 on the agent's caller: the proposal is destructive, targets the account and shows one
/// <code>OAuthTokens</code> row naming it, and nothing is revoked at the mint; its confirm deletes
/// exactly the holder's tokens and the ledger row records the agent marker (AD-15). A name no
/// account carries is refused at the mint as not present.</p>
/// <p>Mutations (Rule 19): set <parameter>OcuPilot.Screen.Tool.UserTokenRevoke.DESTRUCTIVE</parameter>
/// to 0, or answer no row from its <method>OcuPilot.Screen.Tool.UserTokenRevoke.StateDiff</method>
/// -> this goes red.</p>
Method TestTheAgentsRevokeIsMintedDestructiveAndConfirmedMarked()
{
    Set tHolder = $Parameter(..#PROBE, "HOLDER")
    Set tSC = ##class(OcuPilot.Test.ProposalFixture).SeedTurn($Username, "completed", .tTurnKey)
    Do $$$AssertStatusOK(tSC, "a completed probe turn is seeded")
    If $$$ISERR(tSC) Quit
    Do ##class(OcuPilot.Kernel.Proposal.Caller).Set(tTurnKey)
    Set tSC = $ClassMethod(..#TOOLCLASS, "View", "", {"Name": (..#ABSENT)}, 0, .tAbsent, .tHttp, .tFault)
    Do $$$AssertStatusNotOK(tSC, "a name no account carries is refused at the mint")
    Do $$$AssertTrue((tHttp = 400) && ($Select($IsObject($Get(tFault)) && (tFault.%GetTypeOf("detail") = "object"): tFault.%Get("detail").%Get("problem"), 1: "") [ "is not present"), "at 400, as not present")
    Set tSC = $ClassMethod(..#TOOLCLASS, "View", "", {"Name": (tHolder)}, 0, .tProposal, .tHttp, .tFault)
    Do ##class(OcuPilot.Kernel.Proposal.Caller).Clear()
    Do $$$AssertStatusOK(tSC, "the revoke is minted: " _ $System.Status.GetErrorText(tSC))
    If '$IsObject($Get(tProposal)) Quit
    Do $$$AssertEquals($ZConvert(tProposal.%Get("target").%Get("id"), "L") _ " " _ tProposal.%Get("target").%Get("type"), $ZConvert(tHolder, "L") _ " user", "its target is the account")
    Set tRows = ""
    Set tIterator = tProposal.%Get("changed").%GetIterator()
    While tIterator.%GetNext(.tIndex, .tRow) {
        Set tRows = tRows _ $ListBuild(tRow.%Get("field") _ "=" _ tRow.%Get("before") _ ">" _ tRow.%Get("after") _ $Select(tRow.%Get("removed"): "!", 1: ""))
    }
    Do $$$AssertEquals($ListToString(tRows, "|"), "OAuthTokens=" _ tHolder _ ">!", "one removal row naming the account")
    Set tSC = ##class(OcuPilot.Kernel.State.Propose).GuardedByKey(tProposal.%Get("proposalId"), .tFound, .tValues)
    Do $$$AssertTrue($$$ISOK(tSC) && $Get(tFound), "the stored proposal is read")
    Do $$$AssertEquals(+$Get(tValues("destructive")), 1, "and is destructive")
    Do $$$AssertEquals(..Counts(), "2/1/1", "nothing is revoked at the mint")

    Set tSince = ##class(OcuPilot.Test.AuditEvent).Now()
    Set tSC = ##class(OcuPilot.Kernel.Proposal.Confirm).Confirm(tProposal.%Get("proposalId"), "", $Username, .tResult, .tHttp, .tCode, .tDetail)
    Do $$$AssertStatusOK(tSC, "the revoke is confirmed: " _ $Get(tCode))
    Do $$$AssertEquals(..Counts(), "0/1/1", "exactly the holder's tokens are gone")
    Do $$$AssertEquals(##class(OcuPilot.Test.AuditMarker).MarkerRows(tSince, """proposalId"":""" _ tProposal.%Get("proposalId") _ """", .tData), 1, "the audit database carries one agent-write marker naming this proposal")
    Do $$$AssertEquals(##class(OcuPilot.Test.AuditMarker).WriteRow(tTurnKey, .tLedger), 1, "one write-kind ledger row")
    Do $$$AssertEquals($Get(tLedger("AuditMarked")), $Parameter("OcuPilot.Kernel.State.Ledger", "MARKEDYES"), "and the agent marker landed on it")
    Do $$$AssertStatusOK(##class(OcuPilot.Kernel.State.Ledger).GuardedDeleteForTurn(tTurnKey), "this class removes the ledger rows it wrote")
}

/// <p>AD-10: the prohibited set refuses no revoke, the caller's own account and <code>_SYSTEM</code>
/// included, because the write removes no account and changes no field of one.</p>
/// <p>Mutation (Rule 19): set <parameter>OcuPilot.Screen.Tool.UserTokenRevoke.CHANGEACTION</parameter>
/// to <code>deleted</code> -> the set reads the revoke as a removal and refuses both accounts, and
/// this goes red.</p>
Method TestTheProhibitedSetPermitsTheCallerAndTheSystemAccount()
{
    For tName = $Username, "_SYSTEM" {
        Kill tQuery
        Set tQuery("user") = tName
        Set tSC = $ClassMethod(..#PORT, "Invoke", ..#ENDPOINT, "HOLDER", .tQuery, "", .tFresh, .tHttp, .tFault)
        Do $$$AssertStatusOK(tSC, tName _ ": the account reads through the token port")
        If '$IsObject($Get(tFresh)) Continue
        Set tSC = $ClassMethod(..#TOOLCLASS, "StateDiff", tFresh, .tRows, .tProblem)
        Do $$$AssertEquals(tProblem, "", tName _ ": the card's row is computed")
        Set tRef = ""
        Do $$$AssertStatusOK(##class(OcuPilot.Kernel.EntityRef).Key("user", "instance", tName, .tRef), tName _ ": a reference key builds")
        Set tSC = ##class(OcuPilot.Kernel.Proposal.Prohibited).Prohibits(..#TOOL, tRef, "{}", tRows.%ToJSON(), .tProhibits, .tCode)
        Do $$$AssertStatusOK(tSC, tName _ ": the shipped set answers over the shipped port: " _ $System.Status.GetErrorText(tSC))
        Do $$$AssertEquals(tProhibits _ " " _ tCode, "0 ", tName _ ": and permits the revoke")
    }
}

/// <p>AC3, AD-8: a principal holding the list's two pairs and not
/// <parameter>REGISTRATIONPAIR</parameter> is refused by name on both callers before any port call:
/// the principal lacks exactly that pair, the shipped dispatch chain refuses the call naming it, and the screen route
/// answers 403 <code>AUTH.NOPRIVILEGE</code> naming it. No token is touched.</p>
/// <p>Mutation (Rule 19): drop <parameter>OcuPilot.Screen.Tool.UserTokenRevoke.WRITERESOURCE</parameter>
/// from its <method>OcuPilot.Screen.Tool.UserTokenRevoke.PrivilegePairs</method> -> both legs go
/// red.</p>
Method TestAPrincipalWithoutTheRegistrationPairIsRefusedByName()
{
    Set tPrincipal = $Parameter(..#PROBE, "PRINCIPAL")
    Set tSC = ##class(OcuPilot.Screen.Tool.Registry).Resolve(..#TOOL, .tTool)
    Do $$$AssertStatusOK(tSC, "the registry resolves the tool")
    If '$IsObject($Get(tTool)) Quit
    Set tPairs = ##class(OcuPilot.Screen.Tool.Registry).RequiredPairs(tTool, .tResolved)
    Do $$$AssertTrue(tResolved, "its pairs resolve")
    Set tMissing = ""
    For tI = 1:1:$ListLength(tPairs) {
        Set tPair = $List(tPairs, tI)
        If ##class(OcuPilot.Kernel.Agent.Dispatch).HoldsPair(tPrincipal, $List(tPair, 1), $List(tPair, 2)) Continue
        Set tMissing = tMissing _ $Select(tMissing = "": "", 1: ",") _ $ListToString(tPair, ":")
    }
    Do $$$AssertEquals(tMissing, ..#REGISTRATIONPAIR, "the agent's dispatch finds the registration pair, and only it, missing for the principal")
    Do $$$AssertEquals(..DispatchRefusal(), "1|" _ ##class(OcuPilot.Api.Error).#AUTHNOPRIVILEGE _ "|" _ ..#REGISTRATIONPAIR, "and the shipped dispatch chain, with that pair not held, refuses the call naming it")
    Do $$$AssertEquals(..Counts(), "2/1/1", "before any port call")

    Do ..Act($Parameter(..#PROBE, "HOLDER"), .tStatus, .tBody, tPrincipal, ..PreparedPassword)
    Do $$$AssertEquals(tStatus _ " " _ ..Code(tBody), "403 " _ ##class(OcuPilot.Api.Error).#AUTHNOPRIVILEGE, "the screen route refuses the principal: " _ $Select($IsObject(tBody): tBody.%ToJSON(), 1: $Get(tBody)))
    Set tFailed = ""
    If $IsObject(tBody) && (tBody.%GetTypeOf("detail") = "object") Set tFailed = tBody.%Get("detail").%Get("failedPair")
    Do $$$AssertEquals(tFailed, ..#REGISTRATIONPAIR, "naming the registration pair")
    Do $$$AssertEquals(..Counts(), "2/1/1", "and no token is touched")
}

}
