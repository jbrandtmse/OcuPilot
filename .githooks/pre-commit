#!/usr/bin/env bash
#
# Checks for staged files only, so a commit is never blocked by a problem it
# did not introduce. Run the whole checked set by hand with:
#
#   npx markdownlint-cli2               # markdown structure (--fix repairs most of it)
#   uv run scripts/check-prose.py       # fused Given/When/Then, British spellings
#   uv run scripts/check-objectscript.py  # rename tokens, naming, Write discipline
#   uv run scripts/test_check_objectscript.py  # that checker's own rules, over fixtures
#
# Enable once per clone:  git config core.hooksPath .githooks
# Bypass a single commit: git commit --no-verify
#
# Written for bash 3.2, which is what macOS ships: no mapfile, no `set -u`
# around a possibly-empty array.
set -o pipefail

cd "$(git rev-parse --show-toplevel)" || exit 1

STATUS=0

# --- Markdown: structure + prose, staged files narrowed to the checked document set --
#
# The two scopes must agree: a hook that blocks on a file the full run never
# looks at is a commit you cannot unblock by running the linter.
SET_FILE="$(mktemp)"
trap 'rm -f "$SET_FILE"' EXIT
uv run scripts/check-prose.py --list 2>/dev/null |
  sed "s|^$(pwd)/||" | sort > "$SET_FILE"

MD_FILES=()
MD_SKIPPED=()
while IFS= read -r f; do
  [ -z "$f" ] && continue
  if grep -Fxq "$f" "$SET_FILE"; then
    MD_FILES+=("$f")
  else
    MD_SKIPPED+=("$f")
  fi
done < <(git diff --cached --name-only --diff-filter=ACMR -- '*.md')

if [ ${#MD_SKIPPED[@]} -gt 0 ]; then
  echo "pre-commit: not in the checked document set, skipping:" >&2
  printf '  %s\n' "${MD_SKIPPED[@]}" >&2
  echo "  (add it to DEFAULT_GLOBS in scripts/check-prose.py to check it)" >&2
fi

if [ ${#MD_FILES[@]} -gt 0 ]; then
  if command -v npx >/dev/null 2>&1; then
    npx --yes markdownlint-cli2 -- "${MD_FILES[@]}" || STATUS=1
  else
    echo "pre-commit: npx not found, skipping markdownlint" >&2
  fi

  if command -v uv >/dev/null 2>&1; then
    uv run scripts/check-prose.py "${MD_FILES[@]}" || STATUS=1
  else
    echo "pre-commit: uv not found, skipping check-prose" >&2
  fi
fi

# --- ObjectScript tree: rename tokens, naming, Write discipline -----------------------
#
# check-objectscript.py has no per-file mode — it always scans the whole
# src/OcuPilot/** and ui/** tree, so it only needs to run at all when a commit
# touches one of those trees, not a filtered file list.
#
# Both the root-level and the nested form of each pathspec are listed on purpose. A
# git pathspec is not a shell glob: without :(glob) magic, 'src/OcuPilot/**/*.cls'
# requires at least one intermediate directory, so a class placed directly at
# src/OcuPilot/Stray.cls never triggered this hook — which is exactly the misplaced
# class check_package_placement exists to catch. Verified: `git ls-files --
# 'scripts/**/*.py'` returns nothing while 'scripts/*.py' returns three files.
# ('ui/**' needs no partner: with no trailing /*, it already matches ui/.npmrc.)
OS_TRIGGER=$(git diff --cached --name-only --diff-filter=ACMR -- \
  'src/OcuPilot/*.cls' 'src/OcuPilot/**/*.cls' \
  'src/OcuPilot/*.mac' 'src/OcuPilot/**/*.mac' \
  'src/OcuPilot/*.inc' 'src/OcuPilot/**/*.inc' 'ui/**')

if [ -n "$OS_TRIGGER" ]; then
  if command -v uv >/dev/null 2>&1; then
    uv run scripts/check-objectscript.py || STATUS=1
  else
    echo "pre-commit: uv not found, skipping check-objectscript" >&2
  fi

  # The client lint (Story 1.2) has no per-file mode either -- it always scans
  # the whole ui/src tree, so it runs on the same ui/** trigger above rather
  # than a second git diff call. The two scopes must agree: a hook that blocks
  # on a file the full run never looks at is a commit you cannot unblock by
  # running the linter.
  if command -v node >/dev/null 2>&1; then
    (cd ui && node tools/client-lint.mjs) || STATUS=1
  else
    echo "pre-commit: node not found, skipping client-lint" >&2
  fi
fi

# --- The checker's own harness --------------------------------------------------------
#
# check-objectscript.py is the pinning gate for several acceptance criteria, so its own
# rules need a gate too. Its trigger is separate from OS_TRIGGER on purpose: the harness
# is about the checker, not about the tree the checker scans, so editing the checker must
# run it even when no .cls and nothing under ui/ is staged. 'scripts/*.py' without a
# '**' partner is deliberate for the reason the comment above records — git resolves
# 'scripts/**/*.py' to nothing, since every script sits directly in scripts/.
PY_TRIGGER=$(git diff --cached --name-only --diff-filter=ACMR -- 'scripts/*.py')

if [ -n "$PY_TRIGGER" ]; then
  if command -v uv >/dev/null 2>&1; then
    uv run scripts/test_check_objectscript.py || STATUS=1
  else
    echo "pre-commit: uv not found, skipping test_check_objectscript" >&2
  fi
fi

if [ $STATUS -ne 0 ]; then
  cat >&2 <<'MSG'

pre-commit: checks failed on staged files.
  Markdown structure:      npx markdownlint-cli2 --fix, then re-stage.
  ObjectScript/ui tree:    read the check-objectscript.py output above and fix the
                           named file/rule, then re-stage.
  Client lint (ui/src):    read the client-lint.mjs output above and fix the
                           named file/line/rule, then re-stage.
  Checker harness:         uv run scripts/test_check_objectscript.py, fix the named
                           case, then re-stage.
  Bypass once with: git commit --no-verify
MSG
fi

exit $STATUS
