#!/usr/bin/env bash
#
# Triggered by the staged paths, and then every checker reads the WORKING TREE (DW-196).
# The two are not the same thing, and the difference is worth stating plainly: staging one
# half of a pair -- a roster without its regenerated manifest, a descriptor without its
# mirror -- is caught, because the checkers see both halves on disk; staging a FIX for a
# problem whose cause is still unstaged passes here and fails in CI, because CI checks the
# committed tree. `.github/workflows/ci.yml` is the gate over what was actually committed;
# this hook is the fast one that runs before it, and only `check-prose`/`markdownlint` narrow
# themselves to the staged file list.
#
# Run the whole checked set by hand with:
#
#   bash scripts/lint-docs.sh           # markdown structure and prose (--fix repairs most of it)
#   uv run scripts/check-prose.py       # fused Given/When/Then, British spellings
#   uv run scripts/check-objectscript.py  # rename tokens, naming, Write discipline
#   uv run scripts/test_check_objectscript.py  # that checker's own rules, over fixtures
#
# Enable once per clone:  git config core.hooksPath .githooks
# Bypass a single commit: git commit --no-verify
#
# Written for bash 3.2, which is what macOS ships: no mapfile, no `set -u`
# around a possibly-empty array.
set -o pipefail

cd "$(git rev-parse --show-toplevel)" || exit 1

STATUS=0

# --- Markdown: structure + prose, staged files narrowed to the checked document set --
#
# The two scopes must agree: a hook that blocks on a file the full run never
# looks at is a commit you cannot unblock by running the linter.
SET_FILE="$(mktemp)"
trap 'rm -f "$SET_FILE"' EXIT
uv run scripts/check-prose.py --list 2>/dev/null |
  sed "s|^$(pwd)/||" | sort > "$SET_FILE"

MD_FILES=()
MD_SKIPPED=()
while IFS= read -r f; do
  [ -z "$f" ] && continue
  if grep -Fxq "$f" "$SET_FILE"; then
    MD_FILES+=("$f")
  else
    MD_SKIPPED+=("$f")
  fi
done < <(git diff --cached --name-only --diff-filter=ACMR -- '*.md')

if [ ${#MD_SKIPPED[@]} -gt 0 ]; then
  echo "pre-commit: not in the checked document set, skipping:" >&2
  printf '  %s\n' "${MD_SKIPPED[@]}" >&2
  echo "  (add it to DEFAULT_GLOBS in scripts/check-prose.py to check it)" >&2
fi

if [ ${#MD_FILES[@]} -gt 0 ]; then
  if command -v npx >/dev/null 2>&1; then
    npx --yes markdownlint-cli2@0.23.2 -- "${MD_FILES[@]}" || STATUS=1
  else
    echo "pre-commit: npx not found, skipping markdownlint" >&2
  fi

  if command -v uv >/dev/null 2>&1; then
    uv run scripts/check-prose.py "${MD_FILES[@]}" || STATUS=1
  else
    echo "pre-commit: uv not found, skipping check-prose" >&2
  fi
fi

# --- ObjectScript tree: rename tokens, naming, Write discipline -----------------------
#
# check-objectscript.py has no per-file mode — it always scans the whole
# src/OcuPilot/** and ui/** tree and scripts/*.sh, so it only needs to run at all when a
# commit touches one of those, not a filtered file list.
#
# Both the root-level and the nested form of each pathspec are listed on purpose. A
# git pathspec is not a shell glob: without :(glob) magic, 'src/OcuPilot/**/*.cls'
# requires at least one intermediate directory, so a class placed directly at
# src/OcuPilot/Stray.cls never triggered this hook — which is exactly the misplaced
# class check_package_placement exists to catch. Verified: `git ls-files --
# 'scripts/**/*.py'` returns nothing while 'scripts/*.py' returns three files.
# ('ui/**' needs no partner: with no trailing /*, it already matches ui/.npmrc.)
#
# module.xml is in the same trigger rather than one of its own: it is generated from
# src/OcuPilot/Install/Roster.cls, so a commit that changes either side must run the drift
# check, and listing the generated artifact as well is what makes a hand-edited manifest with
# no roster change fail the hook too.
# ACMRD, not ACMR: the drift check below refuses a package folder the roster declares but the
# tree no longer holds, and a commit that only DELETES src/OcuPilot/<Package>/** would never
# fire a trigger that ignores deletions -- the one drift direction this story added would be
# the one the hook cannot see.
# 'scripts/*.sh' is here because the checker's admin-API containment rule also reads the
# ObjectScript that CI's shell scripts run inside an instance.
OS_TRIGGER=$(git diff --cached --name-only --diff-filter=ACMRD -- \
  'src/OcuPilot/*.cls' 'src/OcuPilot/**/*.cls' \
  'src/OcuPilot/*.mac' 'src/OcuPilot/**/*.mac' \
  'src/OcuPilot/*.inc' 'src/OcuPilot/**/*.inc' 'ui/**' 'module.xml' 'scripts/*.sh')

if [ -n "$OS_TRIGGER" ]; then
  if command -v uv >/dev/null 2>&1; then
    uv run scripts/check-objectscript.py || STATUS=1
  else
    echo "pre-commit: uv not found, skipping check-objectscript" >&2
  fi

  # The client lint (Story 1.2) has no per-file mode either -- it always scans
  # the whole ui/src tree, so it runs on the same ui/** trigger above rather
  # than a second git diff call. The two scopes must agree: a hook that blocks
  # on a file the full run never looks at is a commit you cannot unblock by
  # running the linter.
  if command -v node >/dev/null 2>&1; then
    (cd ui && node tools/client-lint.mjs) || STATUS=1
  else
    echo "pre-commit: node not found, skipping client-lint" >&2
  fi

  # The classic link-out check (Story 1.15, AD-44) has no per-file mode either -- it always
  # reads the whole src/OcuPilot/Screen/Descriptor tree and the archetype vocabulary beside
  # it, so it runs on the same trigger above rather than a third git diff call. The two
  # scopes must agree, for the reason the client lint's comment records: a hook that blocks
  # on a file the full run never looks at is a commit you cannot unblock by running the
  # checker. It reports its scanned count and every exemption it honors on every run, clean
  # or not, so the hook's output says what it looked at rather than only that it passed.
  if command -v node >/dev/null 2>&1; then
    (cd ui && node tools/classic-links.mjs) || STATUS=1
  else
    echo "pre-commit: node not found, skipping classic-links" >&2
  fi

  # The screen-mirror drift check (Story 1.9, DW-184). `ui/src/app/core/screens.generated.ts`
  # is generated from the descriptor tree, so the two must agree on every commit that can
  # change either -- and this dispatch was the one `prebuild` and `prestart` ran that the hook
  # did not, so a descriptor committed without its regenerated mirror passed here and failed
  # the next build. Same trigger as the checks above, for the reason their comments record.
  if command -v node >/dev/null 2>&1; then
    (cd ui && node tools/screen-mirror.mjs --check) || STATUS=1
  else
    echo "pre-commit: node not found, skipping screen-mirror" >&2
  fi

  # The IPM manifest drift check (Story 1.16, AD-17). module.xml is generated from
  # src/OcuPilot/Install/Roster.cls, so the two must agree on every commit that can change
  # either: the roster, the tree it names, or the manifest itself. Like the checks above it
  # has no per-file mode -- it reads the whole roster, the whole src/OcuPilot tree and the
  # committed manifest -- so it runs on the same trigger rather than a fourth git diff call,
  # and it reports the counts it compared on every run, clean or not.
  if command -v node >/dev/null 2>&1; then
    (cd ui && node tools/ipm-manifest.mjs --check) || STATUS=1
  else
    echo "pre-commit: node not found, skipping ipm-manifest" >&2
  fi

  # The field-list classification check (Story 2.2, AD-3). src/OcuPilot/Screen/Tool/ToolFields.cls
  # is generated from the derived FieldLists.cls and the reviewed Classification.cls, and a
  # refused entry -- a credential not classified secret, a hand-typed path -- must stop the commit
  # that introduces it. Same trigger as the checks above; it reads the three whole files.
  if command -v node >/dev/null 2>&1; then
    (cd ui && node tools/field-lists.mjs --check) || STATUS=1
  else
    echo "pre-commit: node not found, skipping field-lists" >&2
  fi
fi

# --- The checker's own harness --------------------------------------------------------
#
# check-objectscript.py is the pinning gate for several acceptance criteria, so its own
# rules need a gate too. Its trigger is separate from OS_TRIGGER on purpose: the harness
# is about the checker, not about the tree the checker scans, so editing the checker must
# run it even when no .cls and nothing under ui/ is staged. 'scripts/*.py' without a
# '**' partner is deliberate for the reason the comment above records — git resolves
# 'scripts/**/*.py' to nothing, since every script sits directly in scripts/.
PY_TRIGGER=$(git diff --cached --name-only --diff-filter=ACMR -- 'scripts/*.py')

if [ -n "$PY_TRIGGER" ]; then
  if command -v uv >/dev/null 2>&1; then
    uv run scripts/test_check_objectscript.py || STATUS=1
  else
    echo "pre-commit: uv not found, skipping test_check_objectscript" >&2
  fi
fi

if [ $STATUS -ne 0 ]; then
  cat >&2 <<'MSG'

pre-commit: checks failed on staged files.
  Markdown structure:      bash scripts/lint-docs.sh --fix, then re-stage.
  ObjectScript/ui tree:    read the check-objectscript.py output above and fix the
                           named file/rule, then re-stage.
  Client lint (ui/src):    read the client-lint.mjs output above and fix the
                           named file/line/rule, then re-stage.
  Classic links:           read the classic-links.mjs output above and fix the
                           named descriptor's archetype or classicLinkExemption
                           (AD-44), then re-stage.
  Screen mirror:           ui/src/app/core/screens.generated.ts is generated from
                           the descriptor tree. Run
                           `cd ui && node tools/screen-mirror.mjs` and re-stage
                           both.
  IPM manifest:            module.xml is generated from
                           src/OcuPilot/Install/Roster.cls. Edit the roster, never
                           the manifest, then run
                           `cd ui && node tools/ipm-manifest.mjs` and re-stage both.
  Field lists:             src/OcuPilot/Screen/Tool/ToolFields.cls is generated from
                           FieldLists.cls and Classification.cls. Fix the entry
                           field-lists.mjs names, run
                           `cd ui && node tools/field-lists.mjs` and re-stage. A
                           refused FieldLists.cls is regenerated, never edited:
                           `sh scripts/field-lists.sh --container <name>`.
  Checker harness:         uv run scripts/test_check_objectscript.py, fix the named
                           case, then re-stage.
  Bypass once with: git commit --no-verify
MSG
fi

exit $STATUS
